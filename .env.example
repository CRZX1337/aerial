# Aerial configuration
# Copy to .env — none of these values are required; the server also starts
# with an empty .env. IPTV providers are configured IN THE APP (per profile,
# stored client-side), not here.

# Port for the Aerial server
PORT=8080

# How long an Aerial session stays valid (ms). Default: 24h
SESSION_TTL_MS=86400000

# --- Production hardening -------------------------------------------------

# Session cookie Secure flag: auto (default, set when request is HTTPS),
# true (force, e.g. behind a TLS proxy) or false.
# COOKIE_SECURE=auto

# Express "trust proxy" setting for correct client IPs behind a reverse
# proxy. false (default, headers not trusted), true, a number of hops,
# 'loopback', 'uniquelocal' or a CIDR. Required if a proxy terminates TLS
# and you want the rate limiter to see real client IPs.
# TRUST_PROXY=1

# Login rate limiting (per IP, /api/auth/login only)
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MS=300000
